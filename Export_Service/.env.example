SERVICE_NAME=export-service
ENVIRONMENT=development
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=graphic_tracker
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
CORS_ALLOWED_ORIGINS=["http://localhost:5173"]
LOG_LEVEL=INFO
# Mismo contenedor que Projects Service (Projects escribe, Export solo lee).
# UseDevelopmentStorage=true apunta al emulador Azurite local.
AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true
AZURE_STORAGE_CONTAINER=versions
AUTH_SERVICE_URL=http://auth-service:8000
